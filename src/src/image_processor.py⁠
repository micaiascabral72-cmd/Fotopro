import cv2
import numpy as np
from PIL import Image, ImageEnhance
from rembg import remove
import logging

# Configuração básica de log
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class ImageProcessingError(Exception):
    """Exceção customizada para erros no processamento de imagem."""
    pass

class CorporatePortraitProcessor:
    """
    Classe responsável pelo pipeline de processamento de imagem.
    Garante a preservação da identidade operando apenas na extração
    do background, ajustes de cor/luz globais e reenquadramento.
    """
    
    @staticmethod
    def detect_face(image: Image.Image) -> bool:
        """
        Verifica se há um rosto na imagem usando OpenCV Haar Cascades.
        
        Args:
            image (Image.Image): Imagem original em formato PIL.
            
        Returns:
            bool: True se pelo menos um rosto for detectado, False caso contrário.
        """
        try:
            # Converte PIL para OpenCV array (Grayscale)
            img_array = np.array(image.convert('L'))
            
            # Carrega o classificador pré-treinado do OpenCV
            cascade_path = cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
            face_cascade = cv2.CascadeClassifier(cascade_path)
            
            # Detecta faces
            faces = face_cascade.detectMultiScale(
                img_array, 
                scaleFactor=1.1, 
                minNeighbors=5, 
                minSize=(100, 100)
            )
            return len(faces) > 0
        except Exception as e:
            logger.error(f"Erro na detecção de face: {e}")
            raise ImageProcessingError("Falha ao analisar a imagem para detecção de rosto.")

    @staticmethod
    def adjust_lighting(image: Image.Image, brightness: float = 1.0, contrast: float = 1.0) -> Image.Image:
        """Ajusta o brilho e contraste da imagem."""
        try:
            enhancer_brightness = ImageEnhance.Brightness(image)
            img_bright = enhancer_brightness.enhance(brightness)
            
            enhancer_contrast = ImageEnhance.Contrast(img_bright)
            img_final = enhancer_contrast.enhance(contrast)
            return img_final
        except Exception as e:
            logger.error(f"Erro no ajuste de iluminação: {e}")
            raise ImageProcessingError("Falha ao aplicar ajustes de iluminação.")

    @staticmethod
    def create_corporate_portrait(
        original_image: Image.Image, 
        bg_color: tuple, 
        brightness: float, 
        contrast: float
    ) -> Image.Image:
        """
        Executa o pipeline completo: remoção de fundo, ajuste de luz e nova composição.
        
        Args:
            original_image (Image.Image): Imagem enviada pelo usuário.
            bg_color (tuple): Cor RGB para o novo fundo.
            brightness (float): Fator de brilho.
            contrast (float): Fator de contraste.
            
        Returns:
            Image.Image: Retrato corporativo finalizado.
        """
        try:
            # 1. Ajustes de Iluminação no foreground original
            adjusted_img = CorporatePortraitProcessor.adjust_lighting(original_image, brightness, contrast)
            
            # 2. Remoção de Fundo (Retorna RGBA com transparência)
            # O rembg usa modelos de Deep Learning otimizados para segmentação
            foreground = remove(adjusted_img)
            
            # 3. Criação do novo fundo (Sólido, mas poderia ser um gradiente ou imagem carregada)
            background = Image.new("RGBA", foreground.size, bg_color + (255,))
            
            # 4. Composição (Alpha Compositing)
            # Cola o foreground transparente sobre o background sólido
            background.paste(foreground, (0, 0), foreground)
            
            # Converte para RGB para poder salvar como JPEG depois, se necessário
            return background.convert("RGB")
            
        except Exception as e:
            logger.error(f"Erro na composição final: {e}")
            raise ImageProcessingError(f"Falha ao processar o retrato: {str(e)}")
